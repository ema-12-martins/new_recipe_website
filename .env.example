# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# DEV project URL (Project Settings -> API -> Project URL). Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# DEV project publishable key (legacy "anon" key also works). Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. DEV project secret key (legacy "service_role"); bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SERVER ONLY. Long random code (20+ chars) required to create the cookbook owner; use a different one in production.
OWNER_SETUP_CODE=
# DEV project reference id (subdomain of NEXT_PUBLIC_SUPABASE_URL); the test reset refuses any other project.
SUPABASE_DEV_PROJECT_REF=
# DEV session-pooler connection string with password; used only by scripts/supabase-db.mjs.
SUPABASE_DEV_DB_URL=
# PRODUCTION session-pooler connection string with password; used only by scripts/supabase-db.mjs.
SUPABASE_PROD_DB_URL=
# Public production address of the deployed app (e.g. https://<name>.vercel.app); used by production smoke tests.
PRODUCTION_URL=
# Set to true ONLY in .env.local for the DEV project; enables the destructive test database reset.
ALLOW_TEST_DB_RESET=
# SERVER ONLY. Recipe photo reader: empty picks "groq" when GROQ_API_KEY is set, otherwise "tesseract"; "stub" returns a fixed draft for tests; "off" hides Read recipe.
RECOGNITION_PROVIDER=
# SERVER ONLY. Free Groq API key (console.groq.com, no card) for reading recipe photos; never NEXT_PUBLIC_.
GROQ_API_KEY=
